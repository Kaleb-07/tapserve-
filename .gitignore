# ─── Dependencies ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build Output ────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/

# ─── Environment Variables (SECURITY CRITICAL) ───────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ─── Prisma Generated ────────────────────────────────────────────
