# ─── Dependencies ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build Output ────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/

# ─── Environment Variables (SECURITY CRITICAL) ───────────────────
# Never commit real .env files — use .env.example as the template
.env
.env.local
.env.development
.env.production
.env.development.local
.env.test.local
.env.production.local
.env.*.local
api/.env
dashboard/.env
dashboard/src/.env

# ─── Secrets & Keys ──────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
secrets/
private/

# ─── Prisma Generated ────────────────────────────────────────────
# schema.prisma and migrations are safe to commit for schema history
# Ignore generated client binary (platform-specific)
api/node_modules/.prisma/

# ─── Uploaded Files (User Content) ──────────────────────────────
api/uploads/*
!api/uploads/.gitkeep

# ─── Logs ────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── OS & Editor ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
.idea/
*.iml

# ─── TypeScript ──────────────────────────────────────────────────
*.tsbuildinfo
*.d.ts.map

# ─── Debug / Temporary Scripts ───────────────────────────────────
# These should never be committed to version control
debug_*.js
fix_*.js
test_*.js
test.txt
tmp/
temp/
*.tmp
*.bak
*.backup
scratch.*

# ─── Package Manager ─────────────────────────────────────────────
# Uncomment the one you don't use:
# package-lock.json  # (keep if using npm)
# yarn.lock          # (keep if using yarn)

# ─── Runtime ─────────────────────────────────────────────────────
.cache/
.parcel-cache/
*.local
