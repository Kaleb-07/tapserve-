# api/prisma/migrations/ is safe to commit for schema history

# ─── Uploaded Files (User Content) ──────────────────────────────
api/uploads/*
!api/uploads/.gitkeep

# ─── Logs ────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS & Editor ─────────────────────────────────────────────────
