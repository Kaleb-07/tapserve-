datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id        String     @id @default(uuid())
  name      String
  mealType  String     @default("ALL") // BREAKFAST, LUNCH, DINNER, ALL
  order     Int        @default(0)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id            String      @id @default(uuid())
  name          String
  description   String?     @db.Text
  price         Float
  image         String?     @db.LongText
  ingredients   String?     @db.Text
  inStock       Boolean     @default(true)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id            String      @id @default(uuid())
  sourceType    String      // Table, Room, Event, Delivery
  sourceId      String?     // e.g., "5", "101", "Gala-Event"
  mealType      String?     // BREAKFAST, LUNCH, DINNER
  totalPrice    Float
  status        String      @default("PENDING") // PENDING, PREPARING, READY, DELIVERED
  paymentStatus String      @default("UNPAID")  // UNPAID, PAID
  notes         String?     @db.Text
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id])
  quantity       Int      @default(1)
  priceAtOrder   Float
  customizations String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Source {
  id          String   @id @default(uuid())
  type        String
  identifier  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN") // ADMIN, WAITER, CHEF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id           String   @id @default(uuid())
  hotelName    String   @default("Nora Luxe")
  currency     String   @default("USD")
  supportEmail String?
  updatedAt    DateTime @updatedAt
}
